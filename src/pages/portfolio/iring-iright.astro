---
import Base from '../../layouts/Base.astro';
import FactoryClip from '../../components/FactoryClip.astro';
import { site, waLink } from '../../config/site';
const pic = (f: string, alt: string, w = 480, h = 480) => ({ f, alt, w, h });
const schema = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
  { '@type': 'ListItem', position: 2, name: 'Portfolio', item: site.url + '/portfolio' },
  { '@type': 'ListItem', position: 3, name: 'iRing iRight', item: site.url + '/portfolio/iring-iright' } ] }];
const steps = [
  pic('charlene-screenprinting-01', 'Charlene pulling a squeegee across the screen to print the teal design onto a tote bag'),
  pic('screenprint-tote-01', 'Close-up of a tote freshly screenprinted in teal'),
];
const finished = [
  pic('iring-owner-mario', 'Mario Kanasashi, owner, checking a run of iRing iRite! tees'),
  pic('iring-charlene-client', 'Charlene with our client and the finished totes'),
  pic('iring-client-tees-totes', 'Happy client with her tees and totes'),
];
---
<Base title="Case Study: iRing iRight — Branded Tees & Totes | Screenprinting Cape Town" description="How we screenprinted branded tees and tote bags for the iRing iRight team in our Lansdowne, Cape Town factory — from screen to finished product." schema={schema}>
  <section class="page-hero"><div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/portfolio">Portfolio</a> › <span aria-current="page">iRing iRight</span></nav>
    <p class="eyebrow">Case study · Screenprinting</p>
    <h1>iRing iRight — branded tees &amp; totes</h1>
    <p class="lead">The iRing iRight team needed campaign T-shirts and tote bags. We screenprinted the whole run in-house at our Lansdowne factory, from screen to finished product.</p>
  </div></section>
  <div class="divider" aria-hidden="true"></div>
  <section><div class="wrap two-col">
    <div>
      <h2>1. On the press</h2>
      <p>Charlene set up the screen, mixed the teal ink and pulled each print by hand, checking every tote as it came off the press.</p>
      <div class="grid g2 cs-grid">{steps.map((p) => <figure class="cs"><picture><source srcset={`/images/portfolio/${p.f}-thumb.webp`} type="image/webp" /><img src={`/images/portfolio/${p.f}-thumb.jpg`} alt={p.alt} width={p.w} height={p.h} loading="lazy" /></picture><figcaption>{p.alt}</figcaption></figure>)}</div>
    </div>
    <div><h2>See it in action</h2><FactoryClip id="cs-factory-clip" /></div>
  </div></section>
  <section style="padding-top:0"><div class="wrap">
    <h2>2. Quality check &amp; hand-over</h2>
    <p>Mario checked the tees before packing, then the iRing iRight team collected their finished tees and totes.</p>
    <div class="grid g3 cs-grid">{finished.map((p) => <figure class="cs"><a href={`/images/portfolio/${p.f}.webp`}><picture><source srcset={`/images/portfolio/${p.f}.webp`} type="image/webp" /><img src={`/images/portfolio/${p.f}.jpg`} alt={p.alt} loading="lazy" /></picture></a><figcaption>{p.alt}</figcaption></figure>)}</div>
  </div></section>
  <section style="padding-top:0"><div class="wrap"><div class="card bg-c">
    <h2>Need branded tees or totes?</h2>
    <p>Tell us the item, quantity and deadline and upload your artwork. We’ll send a free proof.</p>
    <div class="cta"><a class="btn dark" href="/request-a-quote?method=screenprinting">Get a quote</a><a class="btn wa" href={waLink("Hi Kan Screenprinters, I'd like a quote for branded tees/totes.")} target="_blank" rel="noopener">WhatsApp us</a></div>
  </div></div></section>
  <style>
    .cs{margin:0}.cs img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--radius);display:block;background:#eee}
    .cs figcaption{font-size:.9rem;margin-top:6px;opacity:.85}.cs-grid{margin-top:16px}
  </style>
</Base>
