---
import FactorySection from '../components/FactorySection.astro';
import Base from '../layouts/Base.astro';
import { site, waLink } from '../config/site';
import { services, gifts } from '../data/catalog';
import { stills, photoByFile } from '../data/media';
import Shot from '../components/Shot.astro';
const bestSellers: [string, string][] = [['bobbleheads', 'bobblehead'], ['key-plaques', 'key60'], ['memorial-plaques', 'memorial'], ['crystals', 'crystalCube']];
const homeWork = ['wood-acrylic-vw-plaque-01', 'award-plaque-01', 'screenprint-tshirt-02', 'mug-print-01', 'family-sign-laser-01', 'hard-hat-print-01', 'crystal-3d-car-01', 'desk-organiser-01'];
---
<Base title={`Screenprinting, Engraving & Personalised Gifts in Cape Town | ${site.name}`}
  description="Cape Town print & promo factory since 2000: in-house screenprinting, laser engraving, DTF, UV, digital & pad printing for businesses, the public and trade/promo resellers — plus personalised gifts & plaques.">
  <section class={site.heroVideo ? 'vhero' : 'hero'} aria-label="Introduction">
    {site.heroVideo && <>
      <picture class="poster">
        <source media="(max-width:700px)" srcset="/media/hero-poster-tall.jpg" />
        <img src="/media/hero-poster.jpg" alt="" width="1280" height="720" fetchpriority="high" />
      </picture>
      <video id="hero-video" muted loop playsinline preload="none" poster="/media/hero-poster.jpg" aria-hidden="true"
        data-wide-webm="/media/hero-wide.webm" data-wide-mp4="/media/hero-wide.mp4"
        data-tall-webm="/media/hero-tall.webm" data-tall-mp4="/media/hero-tall.mp4" data-tall-poster="/media/hero-poster-tall.jpg"></video>
    </>}
    <div class="wrap">
      <div>
        <p class="tagline">Gifts • Trophies • Plaques</p>
        <p class="eyebrow" style="color:var(--y)">Cape Town · Since {site.foundingYear}</p>
        <h1>Your brand. Your moments. <span class="script">Kan do it.</span></h1>
        <p class="lead">We’re a local Cape Town print and promo factory. Under one roof we offer screenprinting, laser engraving and cutting, DTF, UV, digital and pad printing — so whether you need 500 branded pens or a single memorial plaque, we can make it.</p>
        <div class="cta">
          <a class="btn dark" href="/request-a-quote">Get a bulk quote</a>
          <a class="btn" href="/order-a-gift">Order a gift</a>
          <a class="btn wa" href={waLink()} target="_blank" rel="noopener">WhatsApp us</a>
          <a class="btn ghost" href={`tel:${site.phoneE164}`}>Call {site.phoneDisplay}</a>
        </div>
        <ul class="trust"><li>✓ In-house factory</li><li>✓ Made to order</li><li>✓ Free digital proof</li><li>✓ Since {site.foundingYear}</li></ul>
      </div>
    </div>
  </section>
  <div class="divider" aria-hidden="true"></div>
  {site.heroVideo && <script is:inline>
    (function(){
      var v=document.getElementById('hero-video'); if(!v) return;
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var tall=window.matchMedia('(max-width:700px)').matches, k=tall?'tall':'wide';
      if(tall) v.poster=v.dataset.tallPoster;
      [['webm','video/webm'],['mp4','video/mp4']].forEach(function(t){var s=document.createElement('source');s.src=v.dataset[k+t[0][0].toUpperCase()+t[0].slice(1)];s.type=t[1];v.appendChild(s);});
      v.load(); var p=v.play(); if(p&&p.catch) p.catch(function(){});
    })();
  </script>}

  <section class="route" aria-labelledby="route-h">
    <div class="wrap">
      <h2 id="route-h" class="sr-only">What are you looking for?</h2>
      <div class="grid g2">
        <div class="card bg-k">
          <h3>For Business, Clubs &amp; Schools</h3>
          <p>Branded apparel, promo items, signage and trophies — bulk orders with artwork upload. Promo company? <a href="/trade">See trade &amp; resellers</a>.</p>
          <p><a class="btn cyan" style="margin-top:12px" href="/request-a-quote">Get a bulk quote →</a></p>
        </div>
        <div class="card bg-m">
          <h3>Personalised Gifts</h3>
          <p>Bobbleheads, milestone keys, memorial plaques and 3D crystals.</p>
          <p><a class="btn yellow" style="margin-top:12px" href="/gifts">Shop gifts →</a></p>
        </div>
      </div>
    </div>
  </section>

  <FactorySection />
  <section class="trade" aria-labelledby="trade-h" style="padding-top:0">
    <div class="wrap">
      <div class="card bg-c">
        <p class="eyebrow">Trade &amp; Resellers</p>
        <h2 id="trade-h">Print partner for promotional companies</h2>
        <p>We’re the factory behind many Cape Town promo brands. In-house production, bulk runs across six print methods, and unbranded delivery to your client on request. Trade pricing on request.</p>
        <div class="cta">
          <a class="btn dark" href="/request-a-quote?type=trade">Request a trade quote</a>
          <a class="btn ghost" href="/trade">How trade works →</a>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="svc-h" style="padding-top:0">
    <div class="wrap">
      <h2 id="svc-h">Print services</h2>
      <div class="grid g3">
        {services.map((s) => <a class={`card bg-${s.color}`} href={`/services/${s.slug}`}><h3>{s.title}</h3><p>{s.short}</p></a>)}
      </div>
    </div>
  </section>

  <section aria-labelledby="gift-h" style="padding-top:0">
    <div class="wrap">
      <h2 id="gift-h">Gifts — shop by occasion</h2>
      <div class="grid g4">
        <a class="card bg-m" href="/gifts/key-plaques"><h3>21st · 50th · 60th</h3><p>Acrylic milestone keys</p></a>
        <a class="card bg-c" href="/gifts/memorial-plaques"><h3>In loving memory</h3><p>Edge-lit memorial &amp; pet plaques</p></a>
        <a class="card bg-y" href="/services/engraving"><h3>Trophies &amp; awards</h3><p>Clubs, schools, corporate</p></a>
        <a class="card bg-k" href="/gifts/bobbleheads"><h3>Just because</h3><p>3D bobbleheads &amp; crystals</p></a>
      </div>
    </div>
  </section>

  <section aria-labelledby="best-h" style="padding-top:0">
    <div class="wrap">
      <h2 id="best-h">Best sellers</h2>
      <div class="grid g4">
        {bestSellers.map(([slug, key]) => { const st = stills[key]; return <a class="shotlink" href={`/gifts/${slug}`}><Shot src={st.src} alt={st.alt} title={gifts.find((g) => g.slug === slug)!.title} sub={st.sub} /></a>; })}
      </div>
    </div>
  </section>

  <section aria-labelledby="work-h" style="padding-top:0">
    <div class="wrap">
      <h2 id="work-h">Recent client work</h2>
      <ul class="grid g4 pgrid">
        {homeWork.map((f) => { const ph = photoByFile(f); return <li><a href="/portfolio"><picture><source srcset={`/images/portfolio/${f}-thumb.webp`} type="image/webp" /><img src={`/images/portfolio/${f}-thumb.jpg`} alt={ph.alt} width="480" height="480" loading="lazy" /></picture></a></li>; })}
      </ul>
      <p><a class="btn dark" href="/portfolio">See the full portfolio →</a></p>
    </div>
  </section>

  <section class="steps" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h">How it works</h2>
      <ol class="grid g4">
        <li>Pick your product &amp; occasion</li>
        <li>Send names, dates, photos or artwork</li>
        <li>Approve your free proof</li>
        <li>Collect or get it delivered</li>
      </ol>
    </div>
  </section>

  <section class="endline" aria-labelledby="end-h">
    <div class="wrap">
      <h2 id="end-h" class="big" style="font-size:clamp(1.5rem,4vw,2.3rem)">Personalised. Precise. Printed with Pride.</h2>
      <span class="cmyk-line" style="margin:0 auto 22px;width:120px" aria-hidden="true"></span>
      <a class="btn pulse" href="/order-a-gift">Order yours today</a>
    </div>
  </section>
  <div class="divider" aria-hidden="true"></div>

  <section aria-labelledby="social-h">
    <div class="wrap center">
      <h2 id="social-h">Follow the <span class="script">making-of</span></h2>
      <p>See our latest bobbleheads, keys and engraving jobs.</p>
      <div class="cta" style="justify-content:center">
        <a class="btn dark" href={site.socials.instagram} target="_blank" rel="noopener">Instagram @kan_printers</a>
        <a class="btn dark" href={site.socials.tiktok} target="_blank" rel="noopener">TikTok @kan.printers</a>
        <a class="btn dark" href={site.socials.facebook} target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>
  </section>
</Base>
