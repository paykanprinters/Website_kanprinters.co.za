---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
const items = ['Custom 3D bobblehead', 'Man United 21st key', 'Edge-lit pet memorial', '3D crystal on LED base', 'Laser-engraved wood', 'Branded lanyards', 'Screenprinted school tees', 'DTF sports kit', 'UV-printed acrylic', 'Pad-printed pens', 'Pull-up banner', 'Club trophies'];
---
<Base title="Portfolio — Our Printing, Engraving & Gift Work" description="See recent work by Kan Screenprinters: bobbleheads, milestone keys, memorial plaques, crystals, screenprinting, engraving and more.">
  <section class="page-hero"><div class="wrap"><h1>Portfolio</h1><p class="lead">A taste of what we make. For the latest jobs, follow us on <a href={site.socials.instagram}>Instagram</a> and <a href={site.socials.tiktok}>TikTok</a>.</p></div></section>
  <section><div class="wrap">
    <!-- TODO: replace placeholders with real photos (WebP ~1200px, descriptive alt text) -->
    <ul class="grid g4" style="list-style:none;padding:0">
      {items.map((t) => <li><figure class="ph"><figcaption>{t}</figcaption></figure></li>)}
    </ul>
  </div></section>
</Base>
