---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { photos, cats, stills } from '../data/media';
import Shot from '../components/Shot.astro';
const featured = ['bobblehead', 'keyManUtd', 'edgeLit', 'crystalPortrait', 'laser', 'carDisplay', 'keyVw', 'memorial'];
---
<Base title="Portfolio — Our Printing, Engraving & Gift Work" description="See recent work by Kan Screenprinters: bobbleheads, milestone keys, memorial plaques, crystals, screenprinting, engraving and more.">
  <section class="page-hero"><div class="wrap"><h1>Portfolio</h1><p class="lead">A taste of what we make. For the latest jobs, follow us on <a href={site.socials.instagram}>Instagram</a> and <a href={site.socials.tiktok}>TikTok</a>.</p></div></section>
  <div class="divider" aria-hidden="true"></div>
  <section><div class="wrap">
    <h2>Featured project</h2>
    <a class="card bg-y case-link" href="/portfolio/iring-iright" style="display:flex;gap:16px;align-items:center;text-decoration:none;margin-bottom:24px"><picture><source srcset="/images/portfolio/iring-owner-mario-thumb.webp" type="image/webp" /><img src="/images/portfolio/iring-owner-mario-thumb.jpg" alt="Mario Kanasashi, owner, checking a run of iRing iRite! tees" width="120" height="120" loading="lazy" style="width:120px;height:120px;object-fit:cover;border-radius:12px" /></picture><span><span class="eyebrow">Case study</span><h3 style="margin:4px 0">iRing iRight — branded tees &amp; totes</h3><span>From screen to finished product →</span></span></a>
    <h2>Client work</h2>
    <div class="filters" role="group" aria-label="Filter portfolio">
      <button type="button" data-f="all" aria-pressed="true">All</button>
      {cats.map(([k, label]) => <button type="button" data-f={k} aria-pressed="false">{label}</button>)}
    </div>
    <ul class="grid g4 pgrid" id="pgrid">
      {photos.map((p) => <li data-cats={p.cats.join(' ')}><figure>
        <a href={`/images/portfolio/${p.file}.webp`}><picture><source srcset={`/images/portfolio/${p.file}-thumb.webp`} type="image/webp" /><img src={`/images/portfolio/${p.file}-thumb.jpg`} alt={p.alt} width="480" height="480" loading="lazy" /></picture></a>
        <figcaption>{p.alt}</figcaption></figure></li>)}
    </ul>
    <h2 style="margin-top:40px">From our promo video</h2>
    <div class="grid g4">
      {featured.map((k) => <Shot src={stills[k].src} alt={stills[k].alt} title={stills[k].title} sub={stills[k].sub} />)}
    </div>
    <p style="font-size:.85rem;color:var(--muted);margin-top:16px">Club crests and car badges shown are client orders; trademarks belong to their owners.</p>
  </div></section>
  <script is:inline>
    (function(){var bs=document.querySelectorAll('.filters button'),li=document.querySelectorAll('#pgrid li');
      bs.forEach(function(b){b.addEventListener('click',function(){var f=b.dataset.f;bs.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false')});
        li.forEach(function(l){l.hidden=!(f==='all'||l.dataset.cats.split(' ').indexOf(f)>-1)})})})})();
  </script>
</Base>
